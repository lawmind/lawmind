{
  "name": "@lawmind/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "//exports": "Briefing assembly is domain logic the nightly sweep needs too. Exported rather than duplicated, and rather than moved to packages/ for one consumer — the ponytail ladder says the cheapest correct change wins.",
  "exports": {
    "./briefings/assemble": "./src/briefings/assemble.ts",
    "./push/expo": "./src/push/expo.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 src/*.test.ts src/**/*.test.ts",
    "bench": "tsx src/search/bench.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@hono/zod-validator": "^0.9.0",
    "@lawmind/auth": "workspace:*",
    "@lawmind/db": "workspace:*",
    "@lawmind/embed": "workspace:*",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.33",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "tsx": "4.23.1",
    "zod": "4.4.3"
  }
}
