{
  "name": "lawmind",
  "private": true,
  "type": "module",
  "engines": {
    "node": "\u003e=22.23.0",
    "pnpm": "\u003e=11"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --check \"{services,packages}/**/*.{ts,js,json}\" \"*.{json,js}\"",
    "format:write": "prettier --write \"{services,packages}/**/*.{ts,js,json}\" \"*.{json,js}\"",
    "test": "pnpm -r test",
    "check:design": "node scripts/check-design-rules.mjs design/screens"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
