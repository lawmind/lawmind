{
  "name": "lawmind",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --check \"{services,packages}/**/*.{ts,js,json}\" \"*.{json,js}\"",
    "format:write": "prettier --write \"{services,packages}/**/*.{ts,js,json}\" \"*.{json,js}\"",
    "test": "pnpm -r test",
    "check:design": "node scripts/check-design-rules.mjs design/screens",
    "ci:local": "node scripts/ci-local.mjs",
    "harness": "pnpm --filter @lawmind/harness harness",
    "citation-safety-probe": "pnpm --filter @lawmind/harness deployed-safety",
    "judgment-safety-probe": "pnpm --filter @lawmind/harness deployed-judgment-safety",
    "lane:send": "node scripts/lane-send.mjs",
    "lane:inbox": "node scripts/lane-inbox.mjs",
    "lane:status": "node scripts/lane-status.mjs",
    "job:health": "node scripts/job-health.mjs",
    "job:health:publish": "node scripts/job-health.mjs --publish",
    "lane:lease": "node scripts/lane-lease.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "postgres": "3.4.9",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
