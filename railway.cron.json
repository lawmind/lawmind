{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile --filter '!./apps/*'"
  },
  "deploy": {
    "startCommand": "pnpm --filter @lawmind/cron sweep",
    "restartPolicyType": "NEVER",
    "cronSchedule": "30 17 * * *"
  }
}
