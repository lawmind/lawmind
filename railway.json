{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile --filter '!./apps/*'"
  },
  "deploy": {
    "startCommand": "pnpm --filter @lawmind/api start",
    "preDeployCommand": ["pnpm --filter @lawmind/db migrate"],
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE"
  }
}
