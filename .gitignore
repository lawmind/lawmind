node_modules/
.env
.env.*
!.env.example
.expo/
dist/
build/
*.log
.DS_Store
coverage/
.turbo/
*.tsbuildinfo
__pycache__/
*.pyc
.venv/

# Source archives — extracted content is tracked under design/screens/ and the repo root
*.zip

# Embedding model weights — fetched on demand, never committed.
.models/

# Training pairs — versioned JSONL, backed to R2, never in the repo and never in
# the app database. `docs/TRAINING_STRATEGY.md` §4: JSONL diffs are useless and
# the repo becomes unclonable. Pairs derived from sensitive-class data carry the
# same DPDP treatment as their source.
#
# **Anchored to the repo root, and that anchor is load-bearing.** An unanchored
# `training/` matches a directory of that name at ANY depth — including
# `services/api/src/training/`, which is application source (`consent.ts`,
# `extract.ts`) imported by `app.ts`, not generated JSONL. That collision
# silently gitignored real source code: every deploy since `app.ts` started
# importing from it crashed at container boot with
# `ERR_MODULE_NOT_FOUND … services/api/src/training/consent.ts`, because the
# file never reached the commit Railway builds from. Found 11 Aug 2026 reading
# the Railway build log for `docs/ai/tasks/001-p0-citation-query-safety.md`.
/training/

# Recall ground truth — regenerated from the corpus, large, and stale the moment
# the corpus changes. `scripts/measure-recall.mjs` recaptures it when absent.
scripts/recall-ground-truth.json

# Operator scratch files — never shipped, never committed. eslint ignores these too.
*.local.*

# Lane-bus session state — per machine and per session, never shared.
# The MESSAGES stay in git deliberately; who has read them does not.
.agents/bus/.cursor-*
.agents/bus/.lane-*

# Background-job run artifacts. `hc-citations.pid` and `.err` are written by
# `pnpm --filter @lawmind/ingest run hc:citations` when it is backgrounded;
# they name a process id on one machine and are meaningless in the repo.
*.pid
hc-citations.err
arms-run.log
arms-*.log

# Training/evaluation dataset snapshots (services/ingest/src/dataset-export-cli.ts).
# Cut from the database on demand and reproducible from it; they are large,
# they are not source, and a snapshot committed here would go stale silently
# while looking authoritative.
datasets/

# Fleet pause/resume runtime artifacts (scripts/fleet-stop.ps1, NEW2, 15 Aug 2026).
# The checkpoints themselves ARE tracked and stay tracked — these are the
# transient files around them and none is source:
#   *.tmp             the write-then-rename staging file, swept at worker startup
#   STOP              the pause sentinel; committing it would pause a fresh clone
#   *.corrupt-*       a checkpoint preserved for inspection after a failed parse
#   .fleet-stop-*     the pre-pause offset snapshot fleet-stop.ps1 verifies against
services/ingest/.checkpoints/*.tmp
services/ingest/.checkpoints/STOP
services/ingest/.checkpoints/*.corrupt-*
services/ingest/.checkpoints/.fleet-stop-manifest.json

# CX1 proof payloads are reproducible and intentionally disposable. Keep the
# JSON reports and scripts; never commit generated database, Parquet, or IO files.
/docs/ai/cx1-parquet-proof/**/*.parquet
/docs/ai/cx1-parquet-proof/**/benchmark.duckdb*
/docs/ai/cx1-hardware-proof/**/*.bin

# Atomic cost-ledger lock is process-local; approvals and ledger records remain
# visible to git.
/docs/.cost-spend-ledger.lock

# Regenerated on every run of scripts/migration/journal-replay-check.mjs.
scripts/migration/.journal-replay/

# the console-hider watcher's stderr (scripts/pg-hide-consoles.ps1)
pg-hide-consoles.err

# Resource-gate claim markers — `scripts/resource-gate.mjs`. Live process state
# with a 30-minute TTL, meaningful only on the machine that wrote them. A
# committed claim is a claim nobody can release from the box that owns it.
.agents/resource/

# Document-vector batch manifests: 886 files x ~1.4 MB of ids that are
# regenerable from the census in one command, and change every time the corpus
# grows. The SUMMARY (manifest-tier-a.json) is committed; the batches are not.
docs/ai/embedding-manifests/document-vectors/*.jsonl
docs/ai/embedding-manifests/document-vectors/*.meta.json

# Harness stderr dumps. Transient run artifacts, swept into a commit by an
# over-broad `git add -A services/harness` on 19 Aug 2026 (LCC). The
# .generated-cache/ directory was swept in the same way and is deliberately NOT
# ignored here — it is NEW1's and whether it belongs in git is NEW1's call.
services/harness/*.err

# NEW2 model-classification manifest: one JSON line per residue document that
# the frozen deterministic screen cannot call either way, each carrying a 700
# character tail snippet so LCC's model pass needs no second read. ~195,000 rows
# and ~310 MB, regenerable in ~40 minutes from the corpus plus the frozen screen
# artifact by `disposal-manifest-cli`. The SUMMARY
# (new2-model-classification-manifest.json) is committed and carries the counts,
# the frozen screen it was built under and the watermark; the payload is not.
docs/ops/migration/new2-model-classification-manifest.jsonl

# NEW2 scratch: measurement scripts and intermediate artefacts, never committed
.scratch/

# NEW2 R10 working tree. The upstream record walk alone is 1,438 gzipped
# partition files covering 20.3M rows, and the citation expansion journal is one
# line per unresolved edge — 6,046,161 of them. Both are REGENERATED evidence:
# the walk from the bucket, the journal from a resumable sweep. What is worth
# keeping travels as an aggregate in docs/ai/new2-r10/, exactly as the release
# rehearsal's MANIFEST does. The raw data never belongs in git.
.tmp-new2/

# NEW2 damage export: ~1.05GB of per-document evidence, regenerated by
# services/ingest/src/text-damage-cli.ts --export --resume. Local artefact, never a git object.
docs/ops/migration/new2-text-damage.jsonl
docs/ops/migration/new2-text-damage.jsonl.cursor
docs/ops/migration/new2-date-quality.jsonl
docs/ops/migration/new2-date-quality.jsonl.cursor

# ── Regenerable bulk that EXCEEDS GITHUB'S 100 MB PER-BLOB HARD LIMIT ──────────
# These are not a judgement about what is worth keeping. GitHub REJECTS a push
# containing any of them, so a repo that tracked them could not be pushed at all.
# Each is derived, each is reproducible from the corpus plus a committed script,
# and each changes every run — the exact profile the datasets/ and
# document-vectors/ rules already cover.
#
#   arms-checkpoint.jsonl            611 MB  · `pnpm --filter @lawmind/harness arms`
#   arms-checkpoint.pre0055.jsonl    387 MB  · a pre-migration snapshot of the same
#   corpus-confirm.jsonl             130 MB  · LCC text-safety corpus confirmation
#
# The SUMMARIES stay tracked. Only the payloads are ignored.
arms-checkpoint.jsonl
arms-checkpoint.pre*.jsonl
docs/ai/lcc-text-safety/corpus-confirm.jsonl

# Ingest-fleet stderr dumps at the repo root — `hc-hist-*.err`, `hc-hist9-*.err`
# and friends, ~72 MB of them. Transient run artifacts on one machine, exactly
# like `services/harness/*.err` above, which is ignored for the same reason. The
# `*.log` rule at the top of this file already covers their stdout counterparts;
# this covers the stderr side that rule misses.
/*.err

# NEW1 tranche manifest: 38MB of document ids, regenerable byte-identically from
# the committed selector + TRANCHE_FRAME_COMMITMENT.json. The summary IS committed.
docs/ai/new1-tier-a/TRANCHE_100K_MANIFEST.json
docs/ai/new1-tier-a/passage-eval.checkpoint.jsonl

# Resource-lease mutexes are live OS state, never repository content.
.agents/bus/leases/*.lock

# Release packs. release-export-cli.ts writes COPY files and a manifest; the
# bounded 500-judgment rehearsal pack alone is 58 MB and a real one is the whole
# corpus. The MANIFEST and the RESTORE_TRACE are the evidence and are copied into
# docs/ai/<lane>-<round>/ deliberately; the data never belongs in git.
/release/
/release-rehearsal/

# NEW2 R18. The reparse walk intermediate: every non-confirmed row with its full
# evidence fields, 35 MB. It is the INPUT to the two frozen artifacts beside it
# (existing-correction-population.jsonl and untestable-rows.jsonl), both of which
# are committed, and it is regenerable from the committed checkpoint cursor.
docs/ai/new2-r18/candidate-rows.jsonl

# NEW2 R20. The affected-input universe: 1,148,519 judgment ids, 40 MB. Its
# sha256 is recorded in affected-universe-checkpoint.json and count-reconciliation.json,
# which is what makes the walk reproducible; the list itself is regenerable with
# scripts/n2-r20-affected-universe.mts --phase=freeze.
docs/ai/new2-r20/.affected-universe.txt
