{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/reanchor.sh\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "re-anchoring the Lawmind core"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/lane-bus.sh\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "checking the lane bus"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "loading the Lawmind read order"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/lane-wake.sh\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "checking the lane bus before going idle"
          }
        ]
      }
    ]
  }
}
